{
  "name": "template-basic-authenticator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars scripts/operate.mjs dev",
    "dev:worker": "node --env-file-if-exists=.dev.vars scripts/operate.mjs worker-dev",
    "build": "astro build",
    "check": "astro check && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/auth.test.ts",
    "setup": "node scripts/setup.mjs",
    "db:generate": "node scripts/operate.mjs generate",
    "db:migrate:local": "node --env-file-if-exists=.dev.vars scripts/operate.mjs migrate",
    "db:migrate:remote": "node scripts/infrastructure.mjs migrate",
    "db:create": "node scripts/infrastructure.mjs create",
    "db:link": "node scripts/infrastructure.mjs link",
    "admin:bootstrap": "node --env-file-if-exists=.dev.vars scripts/operate.mjs bootstrap",
    "deploy": "node scripts/infrastructure.mjs deploy",
    "worker:check": "node --env-file-if-exists=.dev.vars scripts/operate.mjs worker-check",
    "mail:dev": "node scripts/mail-dev.mjs",
    "types:worker": "node --env-file-if-exists=.dev.vars scripts/operate.mjs types",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" scripts tests \"*.json\" \"*.jsonc\" \"*.ts\" \"*.mjs\" \"docs/*.md\" README.md CHANGELOG.md",
    "start:sqlite": "node --env-file-if-exists=.dev.vars scripts/node-runtime.mjs --engine=sqlite serve",
    "db:migrate:sqlite": "node --env-file-if-exists=.dev.vars scripts/node-runtime.mjs --engine=sqlite migrate",
    "admin:bootstrap:sqlite": "node --env-file-if-exists=.dev.vars scripts/node-runtime.mjs --engine=sqlite bootstrap",
    "test:integration:sqlite": "vitest run --mode tba-sqlite tests/auth.test.ts tests/sql-safety.test.ts",
    "start": "node --env-file-if-exists=.dev.vars scripts/operate.mjs start",
    "test:integration:postgresql": "vitest run --mode tba-postgresql tests/auth.test.ts tests/postgresql.test.ts tests/sql-safety.test.ts tests/postgresql-privileges.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.11",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.13",
    "better-auth": "1.7.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "hono": "4.13.16",
    "lucide-react": "1.68.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@better-auth/utils": "0.5.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261103.0-beta",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "optionalDependencies": {
    "better-sqlite3": "13.2.0"
  }
}
